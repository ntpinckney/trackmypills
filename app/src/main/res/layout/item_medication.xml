<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageButton
        android:id="@+id/notif_button"
        android:src="@drawable/ic_notif_on"
        android:contentDescription="Turn notifications on or off"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:padding="8dp"
        android:layout_gravity="end" />

    <TextView
        android:id="@+id/med_name"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="Medication Name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#463239"/>
    
    <TextView
        android:id="@+id/med_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time"
        android:textSize="16sp"
        android:textColor="@color/text"/>

    <TextView
        android:id="@+id/med_dosage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dosage"
        android:textSize="14sp"
        android:textColor="@color/text"/>


    <TextView
        android:id="@+id/total_meds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total" />

    <ImageButton
        android:id="@+id/expand_button"
        android:src="@drawable/ic_down"
        android:background="@null"
        android:contentDescription="View expandable options"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_gravity="end" />

    <!-- Expandable view -->

    <LinearLayout
        android:id="@+id/expandable_view"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/take_button"
            android:src="@drawable/ic_pill"
            android:contentDescription="Increase doses taken"
            android:background="@color/green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />

        <ImageButton
            android:id="@+id/undo_button"
            android:src="@drawable/ic_undo"
            android:contentDescription="Decrease doses taken"
            android:background="@color/red"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />

        <ImageButton
            android:id="@+id/edit_button"
            android:src="@drawable/ic_edit"
            android:contentDescription="Edit medication"
            android:background="@color/blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageButton
            android:id="@+id/delete_button"
            android:src="@drawable/ic_delete"
            android:contentDescription="Delete medication"
            android:background="@color/dark_red"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>
            />
    </LinearLayout>
</LinearLayout>